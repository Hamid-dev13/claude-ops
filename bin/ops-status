#!/usr/bin/env bash
# ops-status — vue d'ensemble de l'état du serveur. Lecture seule.
#
# Ne prend AUCUN argument : surface d'attaque nulle par construction.
# C'est la commande de diagnostic par défaut de l'agent.

source /usr/local/lib/claude-ops/ops-lib.sh
ops_assert_integrity

(( $# == 0 )) || die "ops-status ne prend aucun argument"

section() { printf '\n=== %s ===\n' "$1"; }

section "CONTENEURS"
docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}' 2>/dev/null \
  || echo "docker indisponible"

section "CONTENEURS ARRÊTÉS (24h)"
docker ps --filter 'status=exited' --filter 'since=24h' \
          --format 'table {{.Names}}\t{{.Status}}' 2>/dev/null | head -20

section "DISQUE"
df -h -x tmpfs -x devtmpfs -x overlay 2>/dev/null

section "MÉMOIRE"
free -h

section "CHARGE"
uptime

section "DOCKER — ESPACE"
docker system df 2>/dev/null || true

exit 0
